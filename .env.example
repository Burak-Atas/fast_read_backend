# Copy to .env and fill in real values. Never commit .env.

# MongoDB
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/
DATABASE_NAME=<database-name>

# JWT signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=<random-64-char-hex>

# Public base URL used to build uploaded video URLs (must end with "/")
SERVER_IP=https://api.example.com/

# Gmail sender account (use an app password)
EMAIL_SENDER=<sender@example.com>
EMAIL_PASSWORD=<gmail-app-password>

# Recipient of /contact form messages
CONTACT_EMAIL=<contact@example.com>

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://example.com,http://localhost:3000

# Flask debug mode (true/false). Keep false in production.
FLASK_DEBUG=false
# Host/port used only by "python app.py" (development server)
HOST=127.0.0.1
PORT=5000
